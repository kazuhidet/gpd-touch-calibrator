#!/usr/bin/python3 -I
"""Root helper for gpd-touch-calibrator.

  gpd-touch-calibrator-apply apply eventN sx cx sy cy
  gpd-touch-calibrator-apply reset eventN

Hyprland always overrides the libinput calibration matrix with its
input:touchdevice:transform, so the fine correction is done one level lower:
the kernel's absolute axis ranges are overridden with EVDEV_ABS_xx (applied by
udev's "keyboard" builtin). libinput normalizes touches against those ranges,
so per axis the normalized coordinate becomes s * h + c, where h is the
coordinate normalized against the panel's original range.

The original ranges and the scale are stored as JSON in the rule's header so
re-runs can compose with what is installed. After writing the rule the HID
driver is rebound so the device is re-created and libinput picks it up.
"""

import fcntl
import json
import os
import re
import struct
import subprocess
import sys
import time

RULE = "/etc/udev/rules.d/99-gpd-touch-calibration.rules"
MARK = "# gpd-touch-calibrator: "
# ABS_X, ABS_Y, ABS_MT_POSITION_X, ABS_MT_POSITION_Y -> axis (0 = x, 1 = y)
AXES = {0x00: 0, 0x01: 1, 0x35: 0, 0x36: 1}


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def eviocgabs(code):
    # _IOR('E', 0x40 + code, struct input_absinfo { s32 value, min, max, fuzz, flat, res; })
    return (2 << 30) | (24 << 16) | (ord("E") << 8) | (0x40 + code)


def read_ranges(ev):
    ranges = {}
    with open(f"/dev/input/{ev}", "rb") as f:
        for code in AXES:
            buf = bytearray(24)
            try:
                fcntl.ioctl(f, eviocgabs(code), buf)
            except OSError:
                continue
            _, lo, hi, *_ = struct.unpack("6i", buf)
            if hi > lo:
                ranges[f"{code:02x}"] = [lo, hi]
    return ranges


def installed_state():
    try:
        with open(RULE) as f:
            for line in f:
                if line.startswith(MARK):
                    return json.loads(line[len(MARK):])
    except (OSError, ValueError):
        pass
    return None


def rebind(ev, name, mode):
    subprocess.run(["udevadm", "control", "--reload"], check=True)
    hid = os.path.realpath(f"/sys/class/input/{ev}/device/device")
    drv = os.path.join(hid, "driver")
    if os.path.exists(drv):
        drv = os.path.realpath(drv)
        hid_id = os.path.basename(hid)
        with open(os.path.join(drv, "unbind"), "w") as f:
            f.write(hid_id)
        time.sleep(0.5)
        with open(os.path.join(drv, "bind"), "w") as f:
            f.write(hid_id)
        subprocess.run(["udevadm", "settle"], check=True)
        print(f"{mode} done: {name} ({hid_id} rebound)")
    else:
        subprocess.run(["udevadm", "trigger", "--action=change", f"/dev/input/{ev}"], check=True)
        print(f"{mode} done: {name} (re-login may be needed)")


def main():
    if len(sys.argv) < 3:
        die("usage: gpd-touch-calibrator-apply apply|reset eventN [sx cx sy cy]")
    mode, ev = sys.argv[1], sys.argv[2]
    if not re.fullmatch(r"event[0-9]+", ev) or not os.path.exists(f"/sys/class/input/{ev}/device/name"):
        die(f"invalid device: {ev}")
    with open(f"/sys/class/input/{ev}/device/name") as f:
        name = f.read().strip()
    if not re.fullmatch(r"[A-Za-z0-9: ._-]+", name):
        die(f"unsupported device name: {name}")

    if mode == "reset":
        try:
            os.remove(RULE)
        except FileNotFoundError:
            pass
    elif mode == "apply":
        try:
            scale = [float(v) for v in sys.argv[3:7]]
        except ValueError:
            scale = []
        if len(scale) != 4 or not all(0.5 < s < 2.0 for s in scale[0::2]) \
                or not all(abs(c) < 0.5 for c in scale[1::2]):
            die(f"invalid scale: {' '.join(sys.argv[3:])}")
        state = installed_state()
        orig = state["orig"] if state else read_ranges(ev)
        if not orig:
            die("could not read the touchscreen's axis ranges")
        assigns = []
        for key, (lo, hi) in sorted(orig.items()):
            s, c = scale[2 * AXES[int(key, 16)]:][:2]
            span = (hi - lo) / s
            new_lo = round(lo - c * span)
            assigns.append(f'ENV{{EVDEV_ABS_{key.upper()}}}="{new_lo}:{round(new_lo + span)}"')
        match = (f'ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", '
                 f'ENV{{ID_INPUT_TOUCHSCREEN}}=="1", ATTRS{{name}}=="{name}"')
        with open(RULE, "w") as f:
            f.write(f"# Generated by gpd-touch-calibrator on {time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n")
            f.write(MARK + json.dumps({"orig": orig, "scale": scale}) + "\n")
            f.write(f"{match}, {', '.join(assigns)}\n")
            f.write(f'{match}, IMPORT{{builtin}}="keyboard"\n')
    else:
        die("usage: gpd-touch-calibrator-apply apply|reset eventN [sx cx sy cy]")

    rebind(ev, name, mode)


if __name__ == "__main__":
    main()
